{
  "name": "token-service-ui",
  "version": "0.1.1",
  "private": true,
  "description": "UI build for Token Service (bundled into token_service/ui/dist)",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "prettier --check \"src/**/*.ts\" &&eslint .",
    "lint:fix": "prettier --write \"src/**/*.ts\" && eslint . --fix"
  },
  "dependencies": {
    "luxon": "3.7.2",
    "mithril": "2.3.8"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/mithril": "2.2.9",
    "@types/luxon": "3.7.4",
    "daisyui": "5.7.16",
    "eslint": "10.8.1",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.1"
  }
}
